@model NexaCart.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Delete Category
        </h2>

        <p class="text-muted mb-0">
            Review the category before deleting it.
        </p>

    </div>


    <!-- Delete Card -->
    <div class="row">

        <div class="col-12 col-lg-8 col-xl-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <!-- Warning Icon -->
                    <div class="mb-4">

                        <div class="bg-danger bg-opacity-10
                                    text-danger rounded-circle
                                    d-inline-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:70px;height:70px;">

                            <i class="bi bi-trash fs-2"></i>

                        </div>

                    </div>


                    <!-- Warning Message -->
                    <h4 class="fw-bold mb-2">
                        Delete this category?
                    </h4>

                    <p class="text-muted mb-4">
                        This action will permanently remove the category.
                        Please make sure you want to continue.
                    </p>


                    <!-- Category Information -->
                    <div class="bg-light rounded p-3 mb-4">

                        <div class="mb-2">

                            <small class="text-muted d-block">
                                Category Name
                            </small>

                            <span class="fw-semibold">
                                @Model.Name
                            </span>

                        </div>


                        <div>

                            <small class="text-muted d-block">
                                Category ID
                            </small>

                            <span class="fw-semibold">
                                #@Model.Id
                            </span>

                        </div>

                    </div>


                    <!-- Actions -->
                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Delete Category

                            </button>


                            <a asp-action="Index"
                               class="btn btn-light px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
